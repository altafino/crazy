{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. No shell access: the backend runs every process (PRD 6.2).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DATA/ai-app-studio/attachments/**"
        }
      ]
    },
    "dialog:allow-open",
    "notification:default"
  ]
}
