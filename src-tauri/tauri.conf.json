{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI App Studio",
  "version": "0.5.0",
  "identifier": "com.altafino.aiappstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI App Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/ai-app-studio/attachments/**"]
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Create, build and install your own apps with AI coding agents",
    "resources": {
      "../templates/tauri-vue/": "templates/tauri-vue/"
    }
  },
  "mainBinaryName": "ai-app-studio"
}
